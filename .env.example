# ---------------------------------------------------------------------------
# Camp Planner configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# --- Authentication ----------------------------------------------------------
# standalone = own users + login page; proxy = identity from trusted X-Remote-*
# headers set by a reverse proxy. Embedded mode ignores it. See docs/DEPLOYMENT.md.
AUTH_MODE=standalone
# Proxy mode, local dev only: stand-in for the proxy headers, "<user_id> [role ...]".
# DEV_USER=dev admin
# Behind a reverse proxy (under a path): trust one hop of X-Forwarded-*.
# BEHIND_PROXY=1

# --- Database selection ----------------------------------------------------
# Either set DATABASE_URL directly (takes precedence) ...
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/camp_planner
#
# ... or pick a backend and let the app assemble the URL from the parts below.
# DB_BACKEND is one of: sqlite | postgresql | mysql
DB_BACKEND=sqlite

# Used when DB_BACKEND=sqlite (relative paths are resolved against the instance dir)
SQLITE_PATH=camp_planner.sqlite

# Used when DB_BACKEND=postgresql or mysql
DB_HOST=localhost
DB_PORT=
DB_NAME=camp_planner
DB_USER=camp
DB_PASSWORD=

# Optional prefix on every table name, so the schema can share a database with
# other apps (e.g. the KSP web). Empty = no prefix. Read at import time, so it
# must match between migration generation and runtime. Example: cp_
DB_TABLE_PREFIX=

# --- Pages and features ------------------------------------------------------
# Template every page extends. Default: _layouts/full.html.
# BASE_TEMPLATE=_layouts/full.html
# Force a colour theme and drop the switch: light | dark | auto. Empty = the visitor picks.
CP_FORCE_THEME=
# Directory for warehouse photo uploads (needs the camp-planner[photos] extra).
# Empty = no photo uploads.
MEDIA_DIR=
# Ceiling on one request body in bytes (photo uploads). Default: 32 MB.
# MAX_UPLOAD_BYTES=33554432
# Features to switch off, comma separated (e.g. "inventory" drops the warehouse
# for a one-off event). Empty = everything on.
CP_DISABLED_FEATURES=

# --- Google Calendar sync (optional) ---
# Enables two-way sync of a camp's timeline with a Google calendar. See
# docs/google_calendar_setup.md. Leave unset to disable and hide the feature
# entirely. Value is either a path to the service-account JSON key file…
# GOOGLE_SERVICE_ACCOUNT_JSON=/etc/camp-planner/service-account.json
# …or the JSON contents inline (handy for container/secret stores):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
